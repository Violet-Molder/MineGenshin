/* assets/minegenshin/lss/hud/mob_health_bar.lss */

#mob_health_bar_root {
    position: absolute;
    width: 100%;
    height: 100%;
}

.mob-health-bar {
    fill-direction: LEFT_TO_RIGHT;
    interpolate: false;
    layout-direction: ltr;
}

/* 正常血量（绿色基础纹理，无额外着色） */
.mob-health-bar.normal .bar-icon {
    background: sprite(minegenshin:gui/short_character_hp_bar_green.png);
}

/* 低于 50%：橙色覆盖 */
.mob-health-bar.low .bar-icon {
    background: sprite(minegenshin:gui/short_character_hp_bar_green.png) color(#FFAA00);
}

/* 低于 30%：红色覆盖 */
.mob-health-bar.critical .bar-icon {
    background: sprite(minegenshin:gui/short_character_hp_bar_green.png) color(#FF3333);
}

/* 空槽背景，不参与着色 */
.mob-health-bar .bar-container {
    background: sprite(minegenshin:gui/short_character_hp_green.png);
}

/* ================= 削韧条（MobPoiseBar） ================= */

.mob-poise-bar {
    fill-direction: RIGHT_TO_LEFT;
    interpolate: false;
    layout-direction: ltr;
}

/* 没破韧：金色，按「已攒削韧 ÷ 这一档的长度」从右往左长 */
.mob-poise-bar.normal .bar-icon {
    background: sprite(minegenshin:gui/short_character_hp_bar_white.png) color(#F2D159);
}

/* 破韧：整条变白 —— 一眼看出「现在这个破绽窗口是开着的」 */
.mob-poise-bar.broken .bar-icon {
    background: sprite(minegenshin:gui/short_character_hp_bar_white.png) color(#FFFFFF);
}

/* 空槽背景：压暗，别和血条抢视线 */
.mob-poise-bar .bar-container {
    background: sprite(minegenshin:gui/short_character_hp_green.png) color(#383F4C);
}
